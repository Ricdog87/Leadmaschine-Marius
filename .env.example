# ─────────────────────────────────────────────────────────────
# RSG·AI Sales Intelligence Dashboard — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is gitignored.
# ─────────────────────────────────────────────────────────────

# Google Sheets — Service Account
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Multi-line key: keep the surrounding quotes, newlines escaped as \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Auth.js (NextAuth v5)
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
AUTH_SECRET=

# Resend (Magic-Link mail delivery)
RESEND_API_KEY=
EMAIL_FROM="RSG·AI <hello@rsg-ai.de>"

# Whitelist (comma-separated, lowercase)
ALLOWED_EMAILS=m.hohmann@hohrising.com,hello@rsg-ai.de

# Workspace (single-tenant today)
ACTIVE_TENANT=hohrising
