# ─────────────────────────────────────────────────────────────
# RSG·AI Sales Intelligence Dashboard — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is gitignored.
# ─────────────────────────────────────────────────────────────

# Google Sheets — Service Account
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Multi-line key: keep the surrounding quotes, newlines escaped as \n
GOOGLE_PRIVATE_KEY=

# Auth.js (NextAuth v5) — Google OAuth provider
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Whitelist (comma-separated, lowercase)
# Marius the Closer · Marvin the Setter · RSG·AI
ALLOWED_EMAILS=m.hohmann@hohrising.com,gmb.hohrising@gmail.com,hello@rsg-ai.de

# Workspace (single-tenant today)
ACTIVE_TENANT=
